{
  "name": "brave-browser-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "按 Brave 行为实现的独立 Electron 浏览器",
  "main": "dist/main/index.js",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.config.ts",
    "start": "electron .",
    "package": "electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@base-ui/react": "1.4.1",
    "better-sqlite3": "13.0.2",
    "dompurify": "3.4.17",
    "lucide-react": "0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.6",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "43.7.5",
    "electron-builder": "26.15.3",
    "typescript": "5.6.3",
    "vite": "6.4.4"
  }
}
