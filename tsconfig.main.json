{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/features/**/main/**/*.ts",
    "src/features/**/page/**/*.ts",
    "src/features/**/runtime/**/*.ts",
    "vite*.ts"
  ]
}
